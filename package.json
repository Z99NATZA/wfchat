{
  "name": "wfchat",
  "version": "0.3.4",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "init": "node scripts/init-env.mjs",
    "test:init": "node --test scripts/init-env.test.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "cargo run --manifest-path apps/api/Cargo.toml",
    "lint:web": "npm --prefix apps/web run lint",
    "format:web:check": "npm --prefix apps/web run format:check",
    "build:web": "npm --prefix apps/web run build",
    "check:api": "cargo check --manifest-path apps/api/Cargo.toml",
    "build": "npm run build:web && npm run check:api",
    "preview:web": "npm --prefix apps/web run preview"
  }
}
