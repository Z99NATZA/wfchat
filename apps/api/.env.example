APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development
RUST_LOG=info
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
ALLOW_SESSION_HEADER=true
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
AUTH_GUEST_REQUESTS_PER_MINUTE=10
AUTH_GUEST_GLOBAL_REQUESTS_PER_MINUTE=60
CAFE_MAX_SOCKETS_PER_SESSION=2
CAFE_MAX_SOCKETS_PER_IP=32
CAFE_MAX_SOCKETS_GLOBAL=512
CAFE_ROOM_CREATIONS_PER_SESSION=5
CAFE_ROOM_CREATIONS_PER_IP=30
CAFE_ROOM_CREATIONS_GLOBAL=300
CAFE_ROOM_CREATION_WINDOW_SECONDS=600
CAFE_WEBSOCKET_MAX_BYTES=16384
CAFE_NEVER_JOINED_TTL_SECONDS=600
CAFE_EMPTY_ROOM_TTL_SECONDS=120
CAFE_CLEANUP_INTERVAL_SECONDS=30
CAFE_TELEMETRY_INTERVAL_SECONDS=60
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wfchat
GOOGLE_CLIENT_ID=

CHAT_MESSAGE_MAX_CHARS=4000
CHAT_REQUEST_MAX_BYTES=65536
CHAT_CONTEXT_MAX_MESSAGES=40
CHAT_CONTEXT_MAX_CHARS=32000
CHAT_OUTPUT_MAX_TOKENS=1024
CHAT_OUTPUT_MAX_CHARS=16384
CHAT_AI_CONNECT_TIMEOUT_SECONDS=10
CHAT_AI_TOTAL_TIMEOUT_SECONDS=60
CHAT_AI_IDLE_TIMEOUT_SECONDS=20
CHAT_MAX_CONCURRENT_GENERATIONS=8
CHAT_MAX_CONCURRENT_PER_SESSION=2
CHAT_REQUESTS_PER_MINUTE=20
CHAT_GLOBAL_REQUESTS_PER_MINUTE=120
CHAT_REGISTERED_DAILY_QUOTA=50
CHAT_GUEST_DAILY_QUOTA=50
CHAT_GLOBAL_DAILY_GENERATION_LIMIT=2000
CHAT_MAX_CHATS_PER_OWNER=50
CHAT_MAX_MESSAGES_PER_CHAT=100
CHAT_MAX_STORED_CHARS_PER_CHAT=500000
# The development example enables media. Keep each feature false in production
# until its provider and public-host boundary are intentionally enabled.
CHAT_IMAGE_UPLOAD_ENABLED=true
CHAT_TRANSCRIPTION_ENABLED=true
CHAT_TTS_ENABLED=true

CHAT_ATTACHMENT_UPLOAD_DIR=data/uploads
CHAT_ATTACHMENT_MAX_BYTES=10485760
CHAT_ATTACHMENT_MAX_IMAGES_PER_MESSAGE=4
CHAT_ATTACHMENT_MAX_WIDTH=8192
CHAT_ATTACHMENT_MAX_HEIGHT=8192
CHAT_ATTACHMENT_MAX_PIXELS=20000000
CHAT_ATTACHMENT_DECODER_MAX_ALLOC_BYTES=134217728
CHAT_ATTACHMENT_MAX_CONCURRENT_DECODES=2
CHAT_ATTACHMENT_MAX_TOTAL_BYTES_PER_MESSAGE=20971520
CHAT_ATTACHMENT_MAX_STORAGE_BYTES_PER_OWNER=209715200

AI_PROVIDER=mock
AI_VOICE_PROVIDER=voicevox
AI_VOICE_MODEL=gpt-4o-mini-tts
AI_VOICE_ID=marin
AI_VOICE_FORMAT=mp3
AI_VOICE_INSTRUCTIONS="Use a warm, calm adult female voice for Aiko, around 30 years old. Keep the delivery natural, intimate, composed, and gently playful; avoid sounding childish or overly energetic."
AI_VOICE_SPEECH_TEXT_POLICY=japanese_translation
AI_TRANSCRIPTION_PROVIDER=mock
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_TRANSCRIPTION_PROMPT=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

XAI_API_KEY=
XAI_MODEL=grok-3-mini
XAI_BASE_URL=https://api.x.ai/v1

VOICEVOX_BASE_URL=http://localhost:50021
VOICEVOX_SPEAKER_ID=23
VOICEVOX_CREDIT="VOICEVOX: WhiteCUL"
VOICEVOX_SPEED_SCALE=1.20
VOICEVOX_PITCH_SCALE=
VOICEVOX_INTONATION_SCALE=
VOICEVOX_VOLUME_SCALE=
